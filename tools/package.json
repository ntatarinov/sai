{
  "name": "sai-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline tooling for Sai: contract validation and verdict application for WF-06 (decisions/0002).",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare-run": "node src/cli.js prepare-run",
    "validate": "node src/cli.js validate",
    "apply-verdict": "node src/cli.js apply-verdict",
    "snapshot": "node src/cli.js snapshot",
    "snapshot-diff": "node src/cli.js snapshot-diff",
    "pixel-office": "node src/pixel-office/main.js",
    "pixel-office-note": "node src/pixel-office/note.js",
    "team": "node src/team/cli.js",
    "team-web": "node src/web/main.js",
    "traces": "node src/traces/cli.js",
    "handoffs-check": "node src/handoffs/cli.js",
    "handoff": "node src/handoffs/handoff.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm run traces && npm run handoffs-check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9"
  }
}
