{
  "schema": "sai-picker-tenant/1",
  "id": "uchet-pro",
  "name": "Учёт-Про",
  "intro": "Учёт-Про помогает навести порядок в товарных остатках. Ответьте на несколько вопросов, и вы увидите, какое решение подойдёт вашему делу.",
  "questions": [
    {
      "id": "business",
      "title": "Чем вы занимаетесь?",
      "type": "single",
      "required": true,
      "options": [
        {
          "id": "retail",
          "label": "Продаю товары в розницу"
        },
        {
          "id": "wholesale",
          "label": "Продаю товары оптом"
        },
        {
          "id": "storage",
          "label": "Храню товары на складе"
        }
      ]
    },
    {
      "id": "items",
      "title": "Сколько видов товара у вас в наличии?",
      "help": "Считайте разные наименования, а не штуки.",
      "type": "number",
      "required": true,
      "min": 1,
      "max": 100000,
      "unit": "видов товара"
    },
    {
      "id": "places",
      "title": "Сколько у вас точек, где лежит товар?",
      "type": "single",
      "required": true,
      "options": [
        {
          "id": "one-place",
          "label": "Одна точка"
        },
        {
          "id": "few-places",
          "label": "От двух до пяти точек"
        },
        {
          "id": "many-places",
          "label": "Больше пяти точек"
        }
      ]
    },
    {
      "id": "tools",
      "title": "Чем вы ведёте учёт сейчас?",
      "type": "multiple",
      "required": true,
      "options": [
        {
          "id": "paper",
          "label": "Тетрадью или бумагой"
        },
        {
          "id": "sheets",
          "label": "Таблицами в компьютере"
        },
        {
          "id": "cash-program",
          "label": "Программой на кассе"
        },
        {
          "id": "nothing",
          "label": "Пока ничем"
        }
      ]
    },
    {
      "id": "problems",
      "title": "Что мешает вам сейчас больше всего?",
      "help": "Отметьте всё, что относится к вашему делу.",
      "type": "multiple",
      "required": true,
      "options": [
        {
          "id": "wrong-stock",
          "label": "Остатки в учёте не совпадают с полкой"
        },
        {
          "id": "slow-count",
          "label": "Пересчёт товара занимает много времени"
        },
        {
          "id": "no-reports",
          "label": "Нет понятных отчётов"
        },
        {
          "id": "losses",
          "label": "Товар пропадает без следа"
        },
        {
          "id": "late-orders",
          "label": "Я поздно замечаю, что товар кончился"
        }
      ]
    },
    {
      "id": "staff",
      "title": "Сколько человек работает с товаром?",
      "type": "number",
      "required": true,
      "min": 1,
      "max": 500,
      "unit": "человек"
    },
    {
      "id": "recount",
      "title": "Как часто вы пересчитываете остатки?",
      "type": "single",
      "required": true,
      "show_if": [
        {
          "question": "problems",
          "any_of": ["wrong-stock", "slow-count"]
        }
      ],
      "options": [
        {
          "id": "daily",
          "label": "Каждый день"
        },
        {
          "id": "weekly",
          "label": "Раз в неделю"
        },
        {
          "id": "rare",
          "label": "Реже, чем раз в месяц"
        }
      ]
    },
    {
      "id": "documents",
      "title": "Сколько накладных вы оформляете за день?",
      "type": "single",
      "required": true,
      "show_if": [
        {
          "question": "business",
          "any_of": ["wholesale", "storage"]
        }
      ],
      "options": [
        {
          "id": "docs-many",
          "label": "Больше двадцати"
        },
        {
          "id": "docs-few",
          "label": "Двадцать или меньше"
        }
      ]
    },
    {
      "id": "barcodes",
      "title": "Есть ли на вашем товаре штрихкоды?",
      "type": "single",
      "required": true,
      "show_if": [
        {
          "question": "items",
          "min": 500
        }
      ],
      "options": [
        {
          "id": "bc-yes",
          "label": "Да, на всём товаре"
        },
        {
          "id": "bc-part",
          "label": "Только на части товара"
        },
        {
          "id": "bc-no",
          "label": "Нет, штрихкодов нет"
        }
      ]
    },
    {
      "id": "migrate",
      "title": "Нужно ли перенести данные из старого учёта?",
      "type": "single",
      "required": true,
      "show_if": [
        {
          "question": "tools",
          "none_of": ["nothing"]
        }
      ],
      "options": [
        {
          "id": "move-data",
          "label": "Да, данные нужно сохранить"
        },
        {
          "id": "start-clean",
          "label": "Нет, начнём с чистого листа"
        }
      ]
    },
    {
      "id": "budget",
      "title": "Какой бюджет на наведение порядка вы готовы выделить?",
      "type": "single",
      "required": false,
      "options": [
        {
          "id": "budget-low",
          "label": "Совсем небольшой"
        },
        {
          "id": "budget-mid",
          "label": "Средний"
        },
        {
          "id": "budget-high",
          "label": "Бюджет не главное"
        }
      ]
    },
    {
      "id": "goal",
      "title": "Что для вас важнее всего?",
      "type": "single",
      "required": true,
      "options": [
        {
          "id": "goal-control",
          "label": "Чтобы товар не пропадал"
        },
        {
          "id": "goal-speed",
          "label": "Чтобы работа шла быстрее"
        },
        {
          "id": "goal-growth",
          "label": "Чтобы можно было расти"
        }
      ]
    }
  ],
  "solutions": [
