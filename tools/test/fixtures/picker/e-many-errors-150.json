{
  "schema": "sai-picker-tenant/1",
  "id": "e-many-errors-150",
  "name": "Пример-Лавка",
  "intro": "Короткий пример файла арендатора. Он нужен только для проверки.",
  "questions": [
    {
      "id": "kind",
      "title": "Что вы продаёте?",
      "type": "single",
      "required": true,
      "options": [
        {
          "id": "fruit",
          "label": "Фрукты"
        },
        {
          "id": "bread",
          "label": "Хлеб"
        }
      ]
    },
    {
      "id": "extras",
      "title": "Что ещё вам нужно?",
      "help": "Отметьте всё нужное.",
      "type": "multiple",
      "required": false,
      "show_if": [
        {
          "question": "kind",
          "any_of": ["fruit"]
        }
      ],
      "options": [
        {
          "id": "bags",
          "label": "Пакеты"
        },
        {
          "id": "boxes",
          "label": "Коробки"
        }
      ]
    },
    {
      "id": "count",
      "title": "Сколько покупателей приходит в день?",
      "type": "number",
      "required": true,
      "min": 1,
      "max": 1000,
      "unit": "человек"
    },
    {
      "id": "rush",
      "title": "Бывают ли очереди?",
      "type": "single",
      "required": true,
      "show_if": [
        {
          "question": "count",
          "min": 50
        },
        {
          "question": "kind",
          "none_of": ["bread"]
        }
      ],
      "options": [
        {
          "id": "queue-yes",
          "label": "Да, бывают"
        },
        {
          "id": "queue-no",
          "label": "Нет, не бывают"
        }
      ]
    }
  ],
  "solutions": [
