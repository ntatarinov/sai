    {
      "match": { "purpose": "review" },
      "steps": [{ "activity": "reading" }],
      "result": {
        "outcome": "ok",
        "cost_usd": 0.01,
        "answer": { "passed": true, "notes": "Критерий выполнен полностью" }
      }
    },
    {
      "match": { "purpose": "goal_check" },
      "steps": [{ "record_input": "goal-input.md" }],
      "result": {
        "outcome": "ok",
        "cost_usd": 0.01,
        "answer": { "passed": true, "notes": "Цель проекта достигнута" }
      }
    }
  ]
}
