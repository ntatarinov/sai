{
  "version": 1,
  "runs": [
    {
      "match": { "purpose": "plan" },
      "steps": [
        { "activity": "thinking" },
        { "record_input": "plan-input.md" }
      ],
      "result": {
        "outcome": "ok",
        "cost_usd": 0.01,
        "answer": {
          "tasks": [
            {
              "key": "prices",
              "role": "researcher",
              "text": "Собрать вымышленные цены трёх поставщиков",
              "done_when": "Есть таблица цен",
              "depends_on": [],
              "critical": false
            },
            {
              "key": "summary",
              "role": "marketer",
              "text": "Подготовить вымышленную сводку для владельца",
              "done_when": "Есть сводка на одну страницу",
              "depends_on": ["prices"],
              "critical": false
            }
          ]
        }
      }
    },
    {
      "match": { "purpose": "work" },
      "steps": [{ "activity": "writing" }, { "record_input": "input.md" }],
      "result": {
        "outcome": "ok",
        "cost_usd": 0.01,
        "answer": { "summary": "Готово по вымышленным данным", "files": [] },
        "files": [
          { "name": "report.md", "content": "Вымышленный отчёт задачи" }
