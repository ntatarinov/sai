# Every variable the code of app/ reads (REQ-108 criterion 13). Values are empty here; secrets are never
# written into git. See app/README.md.
NODE_ENV=
PORT=
HOST=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
APP_DB_PASSWORD=
APP_ORIGIN=
PREVIEW_ORIGIN=
APP_VERSION=
SITE_GATE=
LOG_LEVEL=
MIGRATE_ON_BUILD=
PGLITE_DIR=
MIGRATIONS_DIR=
# Accounts (REQ-114): the HMAC key (base64url of at least 32 bytes) and the sha256 of the one-time setup token.
SECRET_PEPPER=
SETUP_TOKEN_HASH=
# The secret file of app/scripts/uat-login.js and the two databases of app/scripts/db-verify.js.
SAI_UAT_IDENTITY_FILE=
SAI_VERIFY_A_URL=
SAI_VERIFY_B_URL=
# The real Postgres of `npm run test:pg` (the pg job of .github/workflows/app.yml sets them).
SAI_PG_HOST=
SAI_PG_PORT=
SAI_PG_SUPERUSER_PASSWORD=
