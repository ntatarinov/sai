{
  "name": "sai-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/node-main.js",
    "migrate": "node server/db/migrate.js",
    "format": "prettier --write .",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:int": "node --test --test-concurrency=1 \"test/int/**/*.test.js\"",
    "test:pg": "node --test --test-concurrency=1 \"test/pg/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.js\"",
    "vercel-build": "node scripts/vercel-build.js",
    "check": "prettier --check . && eslint . --max-warnings 0 && tsc --noEmit -p jsconfig.json && node scripts/check-public.js && node scripts/vendored.js && node ../tools/src/picker/cli.js check content/sai-intake.json && npm run test:unit && npm run test:int"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "globals": "17.12.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
