{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.js",
    "server/**/*.js",
    "scripts/**/*.js",
    "public/**/*.js",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "server/vendor/picker-engine.js"]
}
