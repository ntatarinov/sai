{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "echo sai-pixel-office >&2; f=\"$1/tools/src/pixel-office/hook.sh\"; if [ -f \"$f\" ]; then /bin/sh \"$f\" >/dev/null 2>&1; fi; exit 0",
              "sai-pixel-office",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 4
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "echo sai-pixel-office >&2; f=\"$1/tools/src/pixel-office/hook.sh\"; if [ -f \"$f\" ]; then /bin/sh \"$f\" >/dev/null 2>&1; fi; exit 0",
              "sai-pixel-office",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 4
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "echo sai-pixel-office >&2; f=\"$1/tools/src/pixel-office/hook.sh\"; if [ -f \"$f\" ]; then /bin/sh \"$f\" >/dev/null 2>&1; fi; exit 0",
              "sai-pixel-office",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 4
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "echo sai-pixel-office >&2; f=\"$1/tools/src/pixel-office/hook.sh\"; if [ -f \"$f\" ]; then /bin/sh \"$f\" >/dev/null 2>&1; fi; exit 0",
              "sai-pixel-office",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 4
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "echo sai-pixel-office >&2; f=\"$1/tools/src/pixel-office/hook.sh\"; if [ -f \"$f\" ]; then /bin/sh \"$f\" >/dev/null 2>&1; fi; exit 0",
              "sai-pixel-office",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 4
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "echo sai-pixel-office >&2; f=\"$1/tools/src/pixel-office/hook.sh\"; if [ -f \"$f\" ]; then /bin/sh \"$f\" >/dev/null 2>&1; fi; exit 0",
              "sai-pixel-office",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 4
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "echo sai-pixel-office >&2; f=\"$1/tools/src/pixel-office/hook.sh\"; if [ -f \"$f\" ]; then /bin/sh \"$f\" >/dev/null 2>&1; fi; exit 0",
              "sai-pixel-office",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 4
          }
        ]
      }
    ]
  }
}
